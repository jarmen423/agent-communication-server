#!/usr/bin/env python3
"""Fake `codex` CLI for tests: `exec [resume] --json … -- [thread] prompt`, `debug models`.

Env:
  FAKE_CODEX_MODE      ok (default) | fail | ofile_only
  FAKE_CODEX_ARGV_LOG  append this invocation's argv (JSON) to the file
"""
import json
import os
import sys

argv = sys.argv[1:]
log = os.environ.get("FAKE_CODEX_ARGV_LOG")
if log:
    with open(log, "a") as f:
        f.write(json.dumps(argv) + "\n")

if argv[:2] == ["debug", "models"]:
    print(json.dumps({"models": [
        {"slug": "gpt-fake-1", "display_name": "GPT-Fake-1", "visibility": "list"},
        {"slug": "gpt-fake-mini", "display_name": "GPT-Fake-Mini", "visibility": "list"},
        {"slug": "internal-review", "display_name": "Internal", "visibility": "hide"},
    ]}))
    sys.exit(0)

if not argv or argv[0] != "exec" or "--json" not in argv or "--" not in argv:
    sys.stderr.write("fake codex: expected `exec [resume] --json ... -- ...`\n")
    sys.exit(2)
resume = len(argv) > 1 and argv[1] == "resume"
rest = argv[argv.index("--") + 1:]
thread_id, prompt = (rest[0], rest[1]) if resume else ("thread-fake-0001", rest[0])
out_file = argv[argv.index("-o") + 1] if "-o" in argv else None
mode = os.environ.get("FAKE_CODEX_MODE", "ok")


def emit(obj):
    sys.stdout.write(json.dumps(obj) + "\n")
    sys.stdout.flush()


emit({"type": "thread.started", "thread_id": thread_id})
emit({"type": "turn.started"})

if mode == "fail":
    emit({"type": "error", "message": "stream disconnected, retrying"})
    emit({"type": "turn.failed", "error": {"message": "rate limited"}})
    sys.exit(1)

answer = f"pong: {prompt}" + (f" (resumed {thread_id})" if resume else "")
if mode == "ofile_only":
    if out_file:
        with open(out_file, "w") as f:
            f.write(f"from file: {prompt}\n")
    emit({"type": "turn.completed", "usage": {"input_tokens": 1, "output_tokens": 1}})
    sys.exit(0)

emit({"type": "item.completed", "item": {"id": "item_0", "type": "reasoning", "text": "thinking about it"}})
emit({"type": "item.started", "item": {"id": "item_1", "type": "command_execution",
                                       "command": "ls", "status": "in_progress"}})
emit({"type": "item.completed", "item": {"id": "item_1", "type": "command_execution",
                                         "command": "ls", "exit_code": 0, "status": "completed"}})
emit({"type": "item.completed", "item": {"id": "item_2", "type": "agent_message", "text": answer}})
emit({"type": "turn.completed", "usage": {"input_tokens": 10, "output_tokens": 5}})
if out_file:
    with open(out_file, "w") as f:
        f.write(answer)
