# ─────────────────────────────────────────────────────────────────────────────
# nats-hub production config — EXAMPLE TEMPLATE
# ─────────────────────────────────────────────────────────────────────────────
# Copy to /etc/nats/nats-server.conf and replace every REPLACE_* placeholder.
# Secrets (token, user passwords) should come from a secrets manager or env
#subst, NOT from this file. See docs/OPERATOR_HUB.md and docs/SECURITY.md.
#
# Validate before deploying:  nats-server -t -c /etc/nats/nats-server.conf
# ─────────────────────────────────────────────────────────────────────────────

server_name: "nats-hub-prod"

# Plain TCP listener — used only by hub-server and other localhost clients.
# Remote agents should NEVER reach this port; keep it behind the firewall on
# VPN/LAN only (see docs/OPERATOR_HUB.md "Firewall").
port: 4222
host: "127.0.0.1"   # bind loopback by default; set 0.0.0.0 only behind a firewall

# Monitoring / varz endpoint. NATS binds the monitoring port to the same
# address family as `host`; if you need it on a different interface, use the
# `http: "host:port"` form. Keep on loopback and reverse-proxy with auth if
# a Prometheus scrape is needed.
http_port: 8222

# ─────────────────────────────────────────────────────────────────────────────
# WebSocket gateway — the only listener remote agents should reach.
# ─────────────────────────────────────────────────────────────────────────────
websocket {
    port: 8080
    # TLS: REQUIRED for any non-loopback exposure. wss:// terminates here.
    # nats-server expects cert/key inside a nested `tls {}` block (NOT as
    # flat keys on the websocket block). See docs/OPERATOR_HUB.md §3.
    # Repo-relative example certs so `nats-server -t -c thisfile` validates
    # from a git checkout. On a real host, copy to /etc/nats/tls/ and rewrite:
    #   cert_file: "/etc/nats/tls/nats-server.crt"
    #   key_file:  "/etc/nats/tls/nats-server.key"
    tls {
        cert_file: "config/tls-example/nats-server.crt"
        key_file:  "config/tls-example/nats-server.key"
    }
    same_origin: false
    handshake_timeout: "5s"
    # Comment out the next line ONLY for a transitional mixed deployment:
    # no_tls: true
}

# ─────────────────────────────────────────────────────────────────────────────
# Authentication & Authorization
# ─────────────────────────────────────────────────────────────────────────────
# Enable EXACTLY ONE of the two authorization blocks below.
# Option B + `hub-server --require-bound-identity` is the only configuration
# that binds identity to credentials end-to-end; Option A is transitional.
# See docs/SECURITY.md for the full threat model.
# ─────────────────────────────────────────────────────────────────────────────

# --- Option A: shared token (transitional; small trusted teams only) --------
# A shared token authenticates the CONNECTION but binds no identity: any holder
# can claim any meta.from and read any inbox. Run hub-server WITHOUT
# --require-bound-identity in this mode — the router is in permissive mode and
# every API caller is unscoped (see docs/SECURITY.md §Threat model).
# authorization {
#     token: "REPLACE_WITH_LONG_RANDOM_TOKEN_FROM_SECRETS_MANAGER"
# }

# --- Option B: per-agent users with identity-bound permissions (required) ----
# The recommended shape. Every agent is a users[] entry whose publish
# permissions are bound to ITS identity (contract §4.1): it can only send as
# itself, and its inbox is private because no other user may subscribe to
# channel.inbox.<id>. Pair with:
#   hub-server --require-bound-identity --api-admin <identity>...
#
# GENERATE these entries with the hub-admin tool — do not hand-edit:
#   hub-admin add-agent echo-1 --role worker --channel chat
#   hub-admin render-config --agents agents.txt --tls-cert ... --tls-key ...
# (agents.txt lines: '<id> <role> <pw:pass|nkey:PUB> [extra channels]')
#
# allowed_connection_types:["WEBSOCKET"] keeps an agent credential off the
# loopback TCP listener; the hub-server service user has no such restriction.
#
# Request-reply (contract C1): every client uses the reply inbox prefix
# _INBOX.<identity>, so each user may subscribe ONLY _INBOX.<its-id>.> and
# has no publish right on _INBOX at all. Users that answer requests (the
# hub-server user, and role=service users such as the worker supervisor)
# get `allow_responses: true` instead.
#
# Durable delivery (docs/DELIVERY.md → Permissions): each agent may attach
# (hub.delivery.<id>.>), read and ack ONLY its own inbox consumer
# (inbox-<id>) and DIRECT.GET the tasks stream; it can never create
# consumers. The hub-server user creates them ($JS.API.>, $JS.ACK.>). These
# grants are harmless when JetStream is off.
authorization {
    users: [
        # role: hub-server (router, query API, wave orchestrator, ws bridge)
        # — keep TCP-local. Every in-process client connects as this user,
        # so they all share the reply prefix _INBOX.hub-server. channel.> is
        # needed by the wave orchestrator (channel.wave.>); the router already
        # sees every envelope on hub.pub.*.>, so it adds no visibility.
        { user: "hub-server", password: "REPLACE_WITH_LONG_RANDOM_PASSWORD",
          permissions: {
            publish:   { allow: ["channel.>", "hub.>", "$JS.API.>", "$JS.ACK.>"] },
            subscribe: { allow: ["hub.>", "channel.>", "_INBOX.hub-server.>"] },
            allow_responses: true,
          } },
        # role: worker — one entry per agent identity.
        { user: "echo-1", password: "REPLACE_WITH_PER_AGENT_PASSWORD",
          allowed_connection_types: ["WEBSOCKET"]
          permissions: {
            publish:   { allow: ["hub.pub.echo-1.>", "hub.register.echo-1",
                                 "hub.presence.echo-1", "hub.api.echo-1.>",
                                 "hub.delivery.echo-1.>",
                                 "$JS.API.CONSUMER.INFO.HUB_INBOX.inbox-echo-1",
                                 "$JS.API.CONSUMER.MSG.NEXT.HUB_INBOX.inbox-echo-1",
                                 "$JS.ACK.HUB_INBOX.inbox-echo-1.>",
                                 "$JS.API.DIRECT.GET.HUB_TASKS"] },
            subscribe: { allow: ["channel.inbox.echo-1", "channel.task.>",
                                 "channel.session.>", "channel.wave.>",
                                 "_INBOX.echo-1.>"] },
          } },
        # role: service — answers hub.worker.* requests (worker supervisor).
        { user: "worker-supervisor", password: "REPLACE_WITH_PER_AGENT_PASSWORD",
          permissions: {
            publish:   { allow: ["hub.pub.worker-supervisor.>",
                                 "hub.register.worker-supervisor",
                                 "hub.presence.worker-supervisor",
                                 "hub.api.worker-supervisor.>", "hub.worker.>",
                                 "hub.delivery.worker-supervisor.>",
                                 "$JS.API.CONSUMER.INFO.HUB_INBOX.inbox-worker-supervisor",
                                 "$JS.API.CONSUMER.MSG.NEXT.HUB_INBOX.inbox-worker-supervisor",
                                 "$JS.ACK.HUB_INBOX.inbox-worker-supervisor.>",
                                 "$JS.API.DIRECT.GET.HUB_TASKS"] },
            subscribe: { allow: ["channel.inbox.worker-supervisor",
                                 "channel.task.>", "channel.session.>",
                                 "channel.wave.>", "_INBOX.worker-supervisor.>",
                                 "hub.presence.*", "hub.register.*",
                                 "hub.worker.>"] },
            allow_responses: true,
          } },
    ]
}

# Add one users{} entry per agent (hub-admin add-agent prints the block).
# To revoke an agent, delete its entry and reload (nats-server --signal reload).

# ─────────────────────────────────────────────────────────────────────────────
# Durable delivery (hub-server --durable) — see docs/DELIVERY.md
# ─────────────────────────────────────────────────────────────────────────────
# Uncomment to keep DMs for offline agents, survive hub-server restarts and
# let delegators resume task results. hub-server creates the streams
# (HUB_INGRESS / HUB_INBOX / HUB_TASKS) itself; size the caps for your
# retention (defaults: 24 h ingress/tasks, 7 d inbox). `hub-admin
# render-config --durable` emits this block for you.
# jetstream {
#     store_dir: "/var/lib/nats-hub/jetstream"
#     max_file_store: 10G
#     max_memory_store: 256M
# }

# ─────────────────────────────────────────────────────────────────────────────
# Capacity & safety limits
# ─────────────────────────────────────────────────────────────────────────────
max_connections: 500        # raise if you have a large fleet; remote + local
max_payload: 10485760       # 10 MiB — room for large agent envelopes
max_pending: 67108864       # 64 MiB per connection buffering ceiling

# Write pidfile so the systemd unit and monitoring can find the daemon.
pid_file: "/run/nats-hub/nats-server.pid"

# ─────────────────────────────────────────────────────────────────────────────
# Logging — rotate via logrotate (see deploy/systemd/README.md).
# ─────────────────────────────────────────────────────────────────────────────
log_file:    "/var/log/nats-hub/nats-server.log"
logtime:     true
debug:       false
trace:       false
max_traced_msg_len: 0
